# ClawCrew ESP32 Smart Room demo — environment variables.
#
# Copy and edit:
#     cp demo/.env.template demo/.env
#     $EDITOR demo/.env
#
# `demo/.env` is gitignored.
#
# The host scripts source this file, while Docker Compose reads demo/.env
# automatically. Both launch paths bridge credentials into current
# schema-mirror env vars without writing secrets into config.toml.

# Primary model provider for this demo (via OpenRouter).
export OPENROUTER_API_KEY=""

# For communicating with the agent via Telegram in host mode.
# Create a bot with @BotFather, get the token, and chat with it (or add to a test group).
export TELEGRAM_BOT_TOKEN=""

# Keep demo data isolated from your normal ClawCrew install.
export CLAWCREW_CONFIG_DIR="$(pwd)/demo/data/config"
export CLAWCREW_WORKSPACE="$(pwd)/demo/data/workspace"

# Focused logging for the demo (simulator + hardware + agent + channels).
export RUST_LOG="clawcrew=info,clawcrew_hardware=info,esp32_sim=info,clawcrew_channels=info"
