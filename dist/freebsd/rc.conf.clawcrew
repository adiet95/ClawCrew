# Per-service rc.conf(5) drop-in for the ClawCrew rc.d script.
#
# Install as /etc/rc.conf.d/clawcrew (the basename must match the rc.d script
# name, which both clawcrew.rc and clawcrew-hardened.rc install as "clawcrew"):
#
#     doas install -m 644 rc.conf.clawcrew /etc/rc.conf.d/clawcrew
#
# Equivalent to the sysrc lines in README.md, but version-controllable as a
# file. Replace youruser with the account that owns ~/.clawcrew.

clawcrew_enable="YES"
clawcrew_runas="youruser"
